{
  "name": "racket-coach-app",
  "version": "0.1.0",
  "description": "Web app for the Racket Coach IMU stroke analyser",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "voice:export": "node ../tools/voice/export-phrases.mjs",
    "voice:generate": "npm run voice:export && python3 ../tools/voice/generate.py && python3 ../tools/voice/verify.py",
    "voice:verify": "python3 ../tools/voice/verify.py"
  },
  "license": "MIT",
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "idb": "^8.0.4",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "@types/web-bluetooth": "^0.0.22",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
